# Copy this file to `.env` and adjust if needed. Every value has a sane default.

# Neo4j credentials (used by both the DB container and the backend)
NEO4J_USER=neo4j
NEO4J_PASSWORD=vectograph

# Host port mappings
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Maximum accepted upload size for a codebase zip (megabytes)
MAX_UPLOAD_MB=50
